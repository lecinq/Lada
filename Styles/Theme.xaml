<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MenuStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="LadaBackgroundBrush" Color="#E00D0F14"/>
    <SolidColorBrush x:Key="LadaBorderBrush" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="LadaBorderHoverBrush" Color="#3D4354"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF"/>
    <SolidColorBrush x:Key="TitleTextBrush" Color="#E8EAED"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8B92A5"/>
    <SolidColorBrush x:Key="IconHoverBackgroundBrush" Color="#1C2028"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#4D5B8DEF"/>
    <SolidColorBrush x:Key="SelectionMarqueeFillBrush" Color="#335B8DEF"/>

    <Thickness x:Key="LadaBorderThickness">1</Thickness>
    <CornerRadius x:Key="LadaCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ColorPickerCornerRadius">8</CornerRadius>
    <DropShadowEffect x:Key="LadaShadowEffect" Color="Black" Opacity="0.4" BlurRadius="24" ShadowDepth="8" Direction="270"/>
    <FontFamily x:Key="LadaFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
