<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="MenuStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- 0x14 / 255 = 7.8% opacity: the desktop remains almost completely
         visible while the saturated frame, glyphs and typography carry the
         HUD hierarchy. HowardHudSurface adds only sparse technical marks. -->
    <SolidColorBrush x:Key="LadaBackgroundBrush" Color="#14020A10"/>
    <SolidColorBrush x:Key="LadaBorderBrush" Color="#00E5FF"/>
    <SolidColorBrush x:Key="LadaBorderHoverBrush" Color="#80F3FF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00E5FF"/>
    <SolidColorBrush x:Key="TitleTextBrush" Color="#F4FCFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#72F5FF"/>
    <SolidColorBrush x:Key="IconHoverBackgroundBrush" Color="#2400E5FF"/>
    <SolidColorBrush x:Key="SelectedBackgroundBrush" Color="#5200E5FF"/>
    <SolidColorBrush x:Key="SelectionMarqueeFillBrush" Color="#3000E5FF"/>

    <Thickness x:Key="LadaBorderThickness">1</Thickness>
    <CornerRadius x:Key="LadaCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ColorPickerCornerRadius">6</CornerRadius>
    <DropShadowEffect x:Key="LadaShadowEffect" Color="#00E5FF" Opacity="0.48" BlurRadius="18" ShadowDepth="0"/>
    <DropShadowEffect x:Key="LadaTextEffect" Color="#000000" Opacity="0.95" BlurRadius="3" ShadowDepth="1" Direction="270"/>
    <FontFamily x:Key="LadaFontFamily">Segoe UI</FontFamily>

</ResourceDictionary>
