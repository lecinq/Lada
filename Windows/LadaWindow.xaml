<Window x:Class="Lada.Windows.LadaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="320" Height="240"
        PreviewMouseLeftButtonDown="LadaWindow_PreviewMouseLeftButtonDown"
        KeyDown="LadaWindow_KeyDown">

    <Viewport3D x:Name="TiltViewport">
        <Viewport3D.Camera>
            <PerspectiveCamera x:Name="TiltCamera" Position="0,0,500" LookDirection="0,0,-1" UpDirection="0,1,0" FieldOfView="30"/>
        </Viewport3D.Camera>
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <AmbientLight Color="White"/>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <Viewport2DVisual3D x:Name="TiltQuad">
            <Viewport2DVisual3D.Transform>
                <Transform3DGroup>
                    <ScaleTransform3D x:Name="TiltScale" ScaleX="1" ScaleY="1" ScaleZ="1"/>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D x:Name="TiltRotationX" Axis="1,0,0" Angle="0"/>
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                    <RotateTransform3D>
                        <RotateTransform3D.Rotation>
                            <AxisAngleRotation3D x:Name="TiltRotationY" Axis="0,1,0" Angle="0"/>
                        </RotateTransform3D.Rotation>
                    </RotateTransform3D>
                </Transform3DGroup>
            </Viewport2DVisual3D.Transform>
            <Viewport2DVisual3D.Geometry>
                <MeshGeometry3D x:Name="TiltMesh"
                                Positions="-160,-120,0 160,-120,0 160,120,0 -160,120,0"
                                TextureCoordinates="0,1 1,1 1,0 0,0"
                                TriangleIndices="0,1,2 0,2,3"/>
            </Viewport2DVisual3D.Geometry>
            <Viewport2DVisual3D.Material>
                <DiffuseMaterial Brush="White" Viewport2DVisual3D.IsVisualHostMaterial="True"/>
            </Viewport2DVisual3D.Material>

    <Grid x:Name="TiltRootContent" Width="320" Height="240">
        <!-- Sized to the window's FULL padded extent (LadaWindow.HudGlow.cs),
             so HudGlowRing's blur has real room to bleed into between
             MainBorder's edge and here. MainBorder itself stays centered
             at its own smaller, logical size (LadaWindow.HudGlow.cs sets
             both explicitly; Viewport2DVisual3D doesn't stretch hosted
             content the normal 2D-layout way, see UpdateTiltGeometry). -->
        <Border x:Name="HudGlowRing"
                Background="Transparent"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="{DynamicResource LadaCornerRadius}"
                IsHitTestVisible="False"
                Visibility="Collapsed"/>

    <Border x:Name="MainBorder"
            Width="320" Height="240"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource LadaBackgroundBrush}"
            BorderBrush="{DynamicResource LadaBorderBrush}"
            BorderThickness="{DynamicResource LadaBorderThickness}"
            CornerRadius="{DynamicResource LadaCornerRadius}"
            Effect="{DynamicResource LadaShadowEffect}"
            SizeChanged="MainBorder_SizeChanged">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border x:Name="TitleBar" Grid.Row="0" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseMove="TitleBar_MouseMove"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconButton" Grid.Column="0" Width="24" Height="24"
                            VerticalAlignment="Center"
                            Margin="10,0,6,0" Background="Transparent"
                            MouseLeftButtonDown="IconButton_MouseLeftButtonDown">
                        <Grid>
                            <Path x:Name="IconButtonPath" Width="20" Height="20" Stretch="Uniform"/>
                            <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=IconButton}"
                                   Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                                <Border x:Name="IconPickerBorder" Background="{DynamicResource LadaBackgroundBrush}"
                                        BorderBrush="{DynamicResource LadaBorderBrush}"
                                        BorderThickness="{DynamicResource LadaBorderThickness}"
                                        CornerRadius="{DynamicResource LadaCornerRadius}" Padding="8">
                                    <StackPanel Width="160">
                                        <WrapPanel x:Name="IconPickerGrid"/>
                                        <Border x:Name="IconPickerDivider" Height="1" Background="{DynamicResource LadaBorderBrush}" Margin="0,8"/>
                                        <WrapPanel x:Name="ColorPickerRow"/>

                                        <Border x:Name="SavedColorsDivider" Height="1" Background="{DynamicResource LadaBorderBrush}" Margin="0,8" Visibility="Collapsed"/>
                                        <WrapPanel x:Name="SavedColorsRow" Visibility="Collapsed"/>

                                        <Border x:Name="CustomColorDivider" Height="1" Background="{DynamicResource LadaBorderBrush}" Margin="0,8"/>

                                        <StackPanel Margin="0,0,0,4">
                                            <Grid Height="18">
                                                <Rectangle RadiusX="9" RadiusY="9">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FF0000" Offset="0"/>
                                                            <GradientStop Color="#FFFF00" Offset="0.167"/>
                                                            <GradientStop Color="#00FF00" Offset="0.333"/>
                                                            <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                            <GradientStop Color="#0000FF" Offset="0.667"/>
                                                            <GradientStop Color="#FF00FF" Offset="0.833"/>
                                                            <GradientStop Color="#FF0000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Background="Transparent" VerticalAlignment="Center" Style="{StaticResource ColorPickerSliderStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,4">
                                            <Grid Height="18">
                                                <Rectangle RadiusX="9" RadiusY="9">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#808080" Offset="0"/>
                                                            <GradientStop x:Name="SaturationGradientStop" Color="#5B8DEF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Slider x:Name="SaturationSlider" Minimum="0" Maximum="100" Background="Transparent" VerticalAlignment="Center" Style="{StaticResource ColorPickerSliderStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,4">
                                            <Grid Height="18">
                                                <Rectangle RadiusX="9" RadiusY="9">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#000000" Offset="0"/>
                                                            <GradientStop x:Name="LightnessGradientMidStop" Color="#5B8DEF" Offset="0.5"/>
                                                            <GradientStop Color="#FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                </Rectangle>
                                                <Slider x:Name="LightnessSlider" Minimum="0" Maximum="100" Background="Transparent" VerticalAlignment="Center" Style="{StaticResource ColorPickerSliderStyle}"/>
                                            </Grid>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="ColorHexBox" Grid.Column="0" MaxLength="7"
                                                     Style="{StaticResource ColorHexBoxStyle}"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource TitleTextBrush}"
                                                     FontFamily="{DynamicResource LadaFontFamily}"
                                                     BorderBrush="{DynamicResource LadaBorderBrush}"
                                                     BorderThickness="1" Padding="4"/>
                                            <Border x:Name="SaveColorButton" Grid.Column="1"
                                                    Width="28" Height="28" Margin="6,0,0,0"
                                                    Background="Transparent"
                                                    Cursor="Hand">
                                                <Path Width="15" Height="15" Stretch="Uniform"
                                                      Fill="{DynamicResource TitleTextBrush}"
                                                      Data="M12.75 9C12.75 8.58579 12.4142 8.25 12 8.25C11.5858 8.25 11.25 8.58579 11.25 9L11.25 11.25H9C8.58579 11.25 8.25 11.5858 8.25 12C8.25 12.4142 8.58579 12.75 9 12.75H11.25V15C11.25 15.4142 11.5858 15.75 12 15.75C12.4142 15.75 12.75 15.4142 12.75 15L12.75 12.75H15C15.4142 12.75 15.75 12.4142 15.75 12C15.75 11.5858 15.4142 11.25 15 11.25H12.75V9Z M12.0574 1.25H11.9426C9.63424 1.24999 7.82519 1.24998 6.41371 1.43975C4.96897 1.63399 3.82895 2.03933 2.93414 2.93414C2.03933 3.82895 1.63399 4.96897 1.43975 6.41371C1.24998 7.82519 1.24999 9.63422 1.25 11.9426V12.0574C1.24999 14.3658 1.24998 16.1748 1.43975 17.5863C1.63399 19.031 2.03933 20.1711 2.93414 21.0659C3.82895 21.9607 4.96897 22.366 6.41371 22.5603C7.82519 22.75 9.63423 22.75 11.9426 22.75H12.0574C14.3658 22.75 16.1748 22.75 17.5863 22.5603C19.031 22.366 20.1711 21.9607 21.0659 21.0659C21.9607 20.1711 22.366 19.031 22.5603 17.5863C22.75 16.1748 22.75 14.3658 22.75 12.0574V11.9426C22.75 9.63423 22.75 7.82519 22.5603 6.41371C22.366 4.96897 21.9607 3.82895 21.0659 2.93414C20.1711 2.03933 19.031 1.63399 17.5863 1.43975C16.1748 1.24998 14.3658 1.24999 12.0574 1.25ZM3.9948 3.9948C4.56445 3.42514 5.33517 3.09825 6.61358 2.92637C7.91356 2.75159 9.62177 2.75 12 2.75C14.3782 2.75 16.0864 2.75159 17.3864 2.92637C18.6648 3.09825 19.4355 3.42514 20.0052 3.9948C20.5749 4.56445 20.9018 5.33517 21.0736 6.61358C21.2484 7.91356 21.25 9.62177 21.25 12C21.25 14.3782 21.2484 16.0864 21.0736 17.3864C20.9018 18.6648 20.5749 19.4355 20.0052 20.0052C19.4355 20.5749 18.6648 20.9018 17.3864 21.0736C16.0864 21.2484 14.3782 21.25 12 21.25C9.62177 21.25 7.91356 21.2484 6.61358 21.0736C5.33517 20.9018 4.56445 20.5749 3.9948 20.0052C3.42514 19.4355 3.09825 18.6648 2.92637 17.3864C2.75159 16.0864 2.75 14.3782 2.75 12C2.75 9.62177 2.75159 7.91356 2.92637 6.61358C3.09825 5.33517 3.42514 4.56445 3.9948 3.9948Z"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <Grid x:Name="TitleColumn" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleTextBlock" Text="Lada"
                                   Style="{StaticResource LadaTitleTextStyle}"
                                   MaxWidth="140" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="TitleTextBox" Visibility="Collapsed"
                                 VerticalAlignment="Center"
                                 MinWidth="80" MaxWidth="140"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TitleTextBrush}"
                                 FontFamily="{DynamicResource LadaFontFamily}" FontSize="13"
                                 LostFocus="TitleTextBox_LostFocus"
                                 KeyDown="TitleTextBox_KeyDown"/>
                    </Grid>

                    <Border x:Name="TitleTabSeparator" Grid.Column="2"
                            Width="1" Margin="8,7,8,7"
                            Background="{DynamicResource LadaBorderBrush}"/>

                    <Border x:Name="TabStripRow" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Left" VerticalAlignment="Center">
                            <StackPanel x:Name="TabStripPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <WrapPanel x:Name="IconGrid" Grid.Row="1" Margin="16"
                       Background="Transparent"
                       AllowDrop="True" DragOver="IconGrid_DragOver" DragLeave="IconGrid_DragLeave" Drop="IconGrid_Drop"
                       PreviewMouseLeftButtonDown="IconGrid_PreviewMouseLeftButtonDown"
                       PreviewMouseMove="IconGrid_PreviewMouseMove"
                       PreviewMouseLeftButtonUp="IconGrid_PreviewMouseLeftButtonUp"/>

            <StackPanel x:Name="ItemListPanel" Grid.Row="1" Margin="16" Visibility="Collapsed"
                        Grid.IsSharedSizeScope="True"
                        Background="Transparent"
                        AllowDrop="True" DragOver="IconGrid_DragOver" DragLeave="IconGrid_DragLeave" Drop="IconGrid_Drop"
                        PreviewMouseLeftButtonDown="IconGrid_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="IconGrid_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="IconGrid_PreviewMouseLeftButtonUp"/>

            <Canvas x:Name="SelectionOverlay" Grid.Row="1" IsHitTestVisible="False">
                <Rectangle x:Name="SelectionMarquee" Visibility="Collapsed"
                           Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                           Fill="{DynamicResource SelectionMarqueeFillBrush}"/>
            </Canvas>

            <Grid x:Name="ToDoListPanel" Grid.Row="1" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ToDoTaskScrollViewer" Grid.Row="0" AllowDrop="True"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ToDoTaskList"/>
                </ScrollViewer>
                <TextBox x:Name="ToDoNewTaskBox" Grid.Row="1" Margin="0,8,0,0"
                         Background="Transparent" BorderThickness="1"
                         BorderBrush="{DynamicResource LadaBorderBrush}"
                         Foreground="{DynamicResource TitleTextBrush}"
                         FontFamily="{DynamicResource LadaFontFamily}"
                         Padding="4"
                         KeyDown="ToDoNewTaskBox_KeyDown"/>
            </Grid>

            <TextBox x:Name="MemoTextBox" Grid.Row="1" Margin="16"
                     Visibility="Collapsed"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{DynamicResource TitleTextBrush}"
                     FontFamily="{DynamicResource LadaFontFamily}"
                     TextChanged="MemoTextBox_TextChanged"/>

            <Grid x:Name="MailPanel" Grid.Row="1" Margin="16" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="MailScrollViewer" Grid.Row="0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MailContentPanel"/>
                </ScrollViewer>
            </Grid>

            <Thumb x:Name="ResizeThumb" Grid.Row="1"
                   Width="16" Height="16"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragStarted="ResizeThumb_DragStarted"
                   DragDelta="ResizeThumb_DragDelta"
                   DragCompleted="ResizeThumb_DragCompleted">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path x:Name="ResizeChevronPath" Data="M11,4 L11,11 L4,11"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
    </Grid>
        </Viewport2DVisual3D>
    </Viewport3D>
</Window>
