<Window x:Class="Lada.Windows.TimerDurationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="260" Height="130"
        Background="{DynamicResource LadaBackgroundBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBox x:Name="HoursBox" Width="40" TextAlignment="Center"
                     Foreground="{DynamicResource TitleTextBrush}" Background="Transparent"
                     BorderBrush="{DynamicResource LadaBorderBrush}" Text="0"/>
            <TextBlock Text=" h " Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
            <TextBox x:Name="MinutesBox" Width="40" TextAlignment="Center"
                     Foreground="{DynamicResource TitleTextBrush}" Background="Transparent"
                     BorderBrush="{DynamicResource LadaBorderBrush}" Text="5"/>
            <TextBlock Text=" m " Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
            <TextBox x:Name="SecondsBox" Width="40" TextAlignment="Center"
                     Foreground="{DynamicResource TitleTextBrush}" Background="Transparent"
                     BorderBrush="{DynamicResource LadaBorderBrush}" Text="0"/>
            <TextBlock Text=" s" Foreground="{DynamicResource TitleTextBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <TextBlock x:Name="HintLabel" Grid.Row="1"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
