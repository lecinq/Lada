<Window x:Class="Lada.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="360"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource LadaBackgroundBrush}"
            BorderBrush="{DynamicResource LadaBorderBrush}"
            BorderThickness="{DynamicResource LadaBorderThickness}"
            CornerRadius="{DynamicResource LadaCornerRadius}"
            Effect="{DynamicResource LadaShadowEffect}">
        <StackPanel>
            <Border x:Name="TitleBar" Height="32" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource LadaTitleTextStyle}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="✕" Cursor="Hand"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{DynamicResource LadaFontFamily}" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               MouseLeftButtonDown="CloseButton_MouseLeftButtonDown"/>
                </Grid>
            </Border>

            <StackPanel Margin="20,4,20,20">
                <TextBlock x:Name="MessageText"
                           Foreground="{DynamicResource TitleTextBrush}"
                           FontFamily="{DynamicResource LadaFontFamily}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"/>
                <TextBlock x:Name="OpenSourceLabel"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="{DynamicResource LadaFontFamily}"
                           FontSize="12"
                           Margin="0,0,0,4"/>
                <TextBlock FontFamily="{DynamicResource LadaFontFamily}" FontSize="12" Margin="0,0,0,8">
                    <Hyperlink NavigateUri="https://github.com/lecinq/Lada" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}">
                        https://github.com/lecinq/Lada
                    </Hyperlink>
                </TextBlock>
                <TextBlock FontFamily="{DynamicResource LadaFontFamily}" FontSize="12">
                    <Hyperlink NavigateUri="https://www.linkedin.com/in/quentin-ecrepont/" RequestNavigate="Hyperlink_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}">
                        linkedin.com/in/quentin-ecrepont
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
