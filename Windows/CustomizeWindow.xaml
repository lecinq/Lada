<Window x:Class="Lada.Windows.CustomizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="400"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource LadaBackgroundBrush}"
            BorderBrush="{DynamicResource LadaBorderBrush}"
            BorderThickness="{DynamicResource LadaBorderThickness}"
            CornerRadius="{DynamicResource LadaCornerRadius}"
            Effect="{DynamicResource LadaShadowEffect}">
        <StackPanel>
            <Border Height="32" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <TextBlock x:Name="TitleLabel"
                               Style="{StaticResource LadaTitleTextStyle}"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBlock Text="✕" Cursor="Hand"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{DynamicResource LadaFontFamily}"
                               FontSize="13"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               MouseLeftButtonDown="CloseButton_MouseLeftButtonDown"/>
                </Grid>
            </Border>

            <StackPanel Margin="20,8,20,22">
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="BrightnessLabel"
                               Foreground="{DynamicResource TitleTextBrush}"
                               FontFamily="{DynamicResource LadaFontFamily}"
                               FontSize="13"/>
                    <TextBlock x:Name="BrightnessValueLabel"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{DynamicResource LadaFontFamily}"
                               FontSize="13"/>
                </Grid>
                <Grid Height="20">
                    <Border Height="4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource LadaBorderBrush}"
                            CornerRadius="2"/>
                    <Slider x:Name="BrightnessSlider"
                            Minimum="0" Maximum="200"
                            TickFrequency="1"
                            Style="{StaticResource ColorPickerSliderStyle}"/>
                </Grid>
                <TextBlock x:Name="BrightnessDescription"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="{DynamicResource LadaFontFamily}"
                           FontSize="11"
                           TextWrapping="Wrap"/>

                <Border Height="1"
                        Margin="0,18,0,16"
                        Background="{DynamicResource LadaBorderBrush}"/>

                <TextBlock x:Name="BackgroundColorLabel"
                           Foreground="{DynamicResource TitleTextBrush}"
                           FontFamily="{DynamicResource LadaFontFamily}"
                           FontSize="13"
                           Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="BackgroundColorButton"
                            Height="32"
                            Padding="10,0"
                            BorderBrush="{DynamicResource LadaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ColorPickerCornerRadius}"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="BackgroundColorButton_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BackgroundColorSwatch"
                                    Width="16" Height="16"
                                    Margin="0,0,8,0"
                                    BorderBrush="{DynamicResource LadaBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource ColorPickerCornerRadius}"/>
                            <TextBlock x:Name="BackgroundColorValue"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TitleTextBrush}"
                                       FontFamily="{DynamicResource LadaFontFamily}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ResetBackgroundColorButton"
                            Height="32"
                            Margin="8,0,0,0"
                            Padding="12,0"
                            BorderBrush="{DynamicResource LadaBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource ColorPickerCornerRadius}"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="ResetBackgroundColorButton_MouseLeftButtonDown">
                        <TextBlock x:Name="ResetBackgroundColorText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TitleTextBrush}"
                                   FontFamily="{DynamicResource LadaFontFamily}"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="BackgroundColorDescription"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="{DynamicResource LadaFontFamily}"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
