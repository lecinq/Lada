<Window x:Class="Lada.Windows.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="360"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource LadaBackgroundBrush}"
            BorderBrush="{DynamicResource LadaBorderBrush}"
            BorderThickness="{DynamicResource LadaBorderThickness}"
            CornerRadius="{DynamicResource LadaCornerRadius}"
            Effect="{DynamicResource LadaShadowEffect}">
        <StackPanel>
            <Border x:Name="TitleBar" Height="32" Background="Transparent"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,12,0">
                    <TextBlock x:Name="TitleTextBlock"
                               Style="{StaticResource LadaTitleTextStyle}"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="✕" Cursor="Hand"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{DynamicResource LadaFontFamily}" FontSize="13"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               MouseLeftButtonDown="CloseButton_MouseLeftButtonDown"/>
                </Grid>
            </Border>

            <StackPanel Margin="20,4,20,20">
                <TextBlock x:Name="MessageText"
                           Foreground="{DynamicResource TitleTextBrush}"
                           FontFamily="{DynamicResource LadaFontFamily}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="CancelButton"
                            Padding="14,7" Margin="0,0,8,0"
                            CornerRadius="{DynamicResource LadaCornerRadius}"
                            BorderBrush="{DynamicResource LadaBorderBrush}"
                            BorderThickness="1" Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="CancelButton_MouseLeftButtonDown">
                        <TextBlock x:Name="CancelButtonText"
                                   Foreground="{DynamicResource TitleTextBrush}"
                                   FontFamily="{DynamicResource LadaFontFamily}" FontSize="12"/>
                    </Border>
                    <Border x:Name="ConfirmButton"
                            Padding="14,7"
                            CornerRadius="{DynamicResource LadaCornerRadius}"
                            Background="{DynamicResource AccentBrush}"
                            Cursor="Hand"
                            MouseLeftButtonDown="ConfirmButton_MouseLeftButtonDown">
                        <TextBlock x:Name="ConfirmButtonText"
                                   FontFamily="{DynamicResource LadaFontFamily}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
