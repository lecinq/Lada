<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Disabled: combined with UseWindowsForms, ImplicitUsings globally
         imports System.Windows.Forms, which collides with WPF's
         System.Windows on Application/MouseEventArgs/DragEventArgs/Cursors.
         Every file declares its own explicit usings instead. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Lada</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gmail widget: hand-rolling OAuth 2.0 + the Gmail REST API was
         evaluated and rejected (see
         docs/superpowers/specs/2026-08-12-mail-widget-design.md); the
         official SDK's GoogleWebAuthorizationBroker already implements the
         loopback+PKCE flow this would otherwise duplicate. Token storage
         still goes through this app's own DPAPI-backed IDataStore, not the
         SDK's plaintext default. -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.75.0.4225" />

    <!-- CPU/GPU load and temperature have no native Win32 equivalent worth
         hand-rolling (unlike Battery/Memory, which stay on plain P/Invoke
         below). -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

  <!-- Lada.Tests lives inside this project's own directory; without this,
       the default SDK glob also compiles the test project's files (and its
       generated obj/ output) into Lada.csproj itself. -->
  <ItemGroup>
    <Compile Remove="Lada.Tests/**" />
    <EmbeddedResource Remove="Lada.Tests/**" />
    <None Remove="Lada.Tests/**" />
    <Page Remove="Lada.Tests/**" />
  </ItemGroup>

</Project>
