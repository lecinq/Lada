<Application x:Class="Lada.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Swapped at runtime by ThemeManager between Theme.xaml (Midnight)
                 and ThemeModernism.xaml. The two Styles below stay outside this
                 merge point so they survive the swap: both themes' brushes share
                 the same resource keys, so a Style that references those keys
                 via DynamicResource works unchanged under either theme. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="LadaTitleTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TitleTextBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource LadaFontFamily}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <Style x:Key="IconLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                <Setter Property="FontFamily" Value="{DynamicResource LadaFontFamily}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
